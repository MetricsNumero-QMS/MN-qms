<%- include('includes/header'); -%>
<%- include('includes/app-shell-start'); -%>
<section class="section-category">
<div class="qms-cat-page"> 
                <% if(message.length > 0) { %>
                <div class="alert alert-success succmsg" role="alert">
                    <i class="bi-check-circle-fill"></i>
                    <strong class="mx-2">Success!</strong> 
                    <%= message %>
                </div>
                <% } %>   
                <% if(succdel.length > 0) { %>
                <div class="alert alert-danger succmsg" role="alert">
                    <%= succdel %>
                </div>
                <% } %> 
                <% if(succupd.length > 0) { %>
                <div class="alert alert-success succmsg" role="alert">
                    <i class="bi-check-circle-fill"></i>
                    <strong class="mx-2">Success!</strong> 
                    <%= succupd %>
                </div>
                <% } %>   
                <div class="qms-cat-topbar">
                    <div class="bread-heading">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item active" aria-current="page">Category</li>
                            </ol>
                        </nav>
                        <nav>
                        <ol class="breadcrumb qms-cat-crumb">
                            <li><a href="/home" class="Bradscram-p1">Home</a></li>
                            <li><span class="Bradscram-p1_Span">Category</span></li>
                            <% if(menu){ %><li><span class="Bradscram-p1_Span"><%= menu; %></span></li><% } %>
                            <% if(submenu){ %><li><span class="Bradscram-p1_Span"><%= submenu; %></span></li><% } %>
                        </ol>
                        </nav>
                    </div>
                    <div class="qms-cat-toolbar">
                        <div class="qms-cat-toolbar-actions">
                            <div class="qms-search-cluster">
                                <button type="button" class="folder-toolbar-btn" id="openFolderWorkspace" title="Controlled folders" aria-label="Controlled folders">
                                    <i class="fa fa-folder" aria-hidden="true"></i>
                                </button>
                                <div class="form-group searchInput">
                                    <input type="search" class="form-control" id="filterbox" placeholder="Search documents" aria-label="Search documents">
                                </div>
                            </div>
                            <button type="button" data-placement="top" title="Send Announcement" class="notify-btn sendNotification qms-notify-btn" data-backdrop="false" data-toggle="tooltip" alt="Send Announcement" data-menu="<%= menu; %>" data-submenu="<%= submenu; %>" data-latest_doc="<%if(latestid.length > 0)  { %><%= latestid %><% } %>" data-file_name="<%if(latestupfile.length > 0)  { %><%= latestupfile %><% } %>">
                                <i class="fa fa-bullhorn chgnotclr" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btnbtnbtn-info qms-upload-btn <%= userrole %>" id="qmsOpenUpload">
                                <i class="fa fa-upload" aria-hidden="true"></i> Upload File
                            </button>
                        </div>
                    </div>
                </div>
                <div class="qms-cat-card">
                    <div class="main-datatable">
                        <table cellspacing="0" style="width:100%;" id="filtertable" class="table cust-datatable display">
                            <thead id="tableheader">
                                <tr>
                                    <th>Sl no</th>
                                    <th>Document Name</th>
                                    <th>Description</th>
                                    <th>Document Version</th>
                                    <th>QMS Version</th>
                                    <th>Released Date</th>
                                    <th class="nosort">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tablebody">
                                <%
                                if(fetchData.length!=0){
                                var i=1;
                                fetchData.forEach(function(data){  
                                var releaseDt   = moment(data.releaseDt).format('DD-MMM-YYYY');                                                            
                                %>
                                <tr>
                                        <td><%=i; %></td>
                                        <td>
                                            <span class="qms-doc-name"><%=data.doc_name%></span>
                                            <span class="qms-ver-inline">v<%= data.version || '1.0' %> · current</span>
                                        </td>           
                                        <td><%=data.docDesc%></td>
                                        <td><%=data.version%></td>              
                                        <td><%=data.docRelVer%></td>
                                        <td><%= releaseDt%></td>
                                        <td class="qms-dt-actions">
                                            <div class="qms-act-row">
                                                <a class="user_logdet qms-act-btn" title="Download" data-file_access_type="1" data-file_name="<%=data.docDn %>" data-doc_id="<%=data.doc_num %>" href="/downloadDocument/<%=menu %>/<%=submenu %>/<%=data.docDn; %>">
                                                    <i class="fa fa-download" aria-hidden="true"></i>
                                                </a>
                                                <button type="button" class="user_logdet viewFile qms-act-btn" title="View" data-file_access_type="0" data-file_name="<%=data.docDn %>" data-menu="<%=menu %>" data-submenu="<%=submenu %>" data-doc_id="<%=data.doc_num %>">
                                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="edit qms-act-btn qms-edit-file" title="Update" data-id="<%= data.doc_num %>">
                                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="qms-act-btn qms-ver-history" title="Version history" data-doc-id="<%= data.doc_num %>" data-doc-name="<%= data.doc_name %>">
                                                    <i class="fa fa-history" aria-hidden="true"></i>
                                                </button>
                                                <a href="javascript:void(0)" class="qms-act-btn qms-del-file" title="Delete" data-menu="<%=menu %>" data-submenu="<%=submenu %>" data-doc_num="<%=data.doc_num %>">
                                                    <i class="fa fa-trash" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <%  i++; }) %>
                                <% } %> 
                            </tbody>
                        </table>
                    </div>
                </div>
    <div class="qms-form-modal" id="upldDoc" tabindex="-1" role="dialog" aria-labelledby="upldDocTitle" aria-hidden="true">
        <div class="modal-dialog qms-form-dialog" role="document">
            <div class="modal-content qms-form-card">
                <div class="modal-header qms-form-header">
                    <div class="qms-form-heading">
                        <span class="qms-form-kicker">Upload document</span>
                        <span class="qms-form-title" id="upldDocTitle"><%= menu; %> / <%= submenu; %></span>
                    </div>
                    <button type="button" class="qms-form-close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <form autocomplete="off" action="/uploadDocument/<%= menu; %>/<%= submenu; %>" enctype="multipart/form-data" method="post" class="valdUsr valdAddFile qms-upload-form qms-form-shell" id="updateUser">
                    <div class="modal-body qms-form-body">
                        <div class="qms-form-grid">
                            <div class="qms-field">
                                <label for="docName">Document name</label>
                                <input type="text" class="form-control docname" placeholder="Enter document name" name="docname" id="docName">
                                <label id="docname-error" class="error" for="docname"></label>
                            </div>
                            <div class="qms-field qms-field-file">
                                <label for="formFile">Document file</label>
                                <label class="qms-file-drop" for="formFile">
                                    <input type="file" class="qms-file-input" name="doc_file" id="formFile" onchange="validateFileType()" required>
                                    <span class="qms-file-icon"><i class="fa fa-cloud-upload" aria-hidden="true"></i></span>
                                    <span class="qms-file-copy">
                                        <strong id="qmsFileLabel">Choose a file</strong>
                                        <small>PDF, Word, Excel or PowerPoint</small>
                                    </span>
                                </label>
                                <label id="doc_file-error" class="error" for="doc_file"></label>
                            </div>
                            <div class="qms-field">
                                <label for="relsVer">QMS released version</label>
                                <input id="relsVer" name="relsVer" type="text" class="form-control" placeholder="e.g. 3.0" required>
                                <label id="relsVer-error" class="error" for="vrelsVer"></label>
                            </div>
                            <div class="qms-field">
                                <label for="docVer">Document version</label>
                                <input id="docVer" name="docVer" type="text" class="form-control" placeholder="e.g. 1.2" required>
                                <label id="docVer-error" class="error" for="docVer"></label>
                            </div>
                            <div class="qms-field qms-field-wide">
                                <label for="docDesc">Description</label>
                                <textarea name="docDesc" class="form-control" id="docDesc" rows="3" placeholder="Short description of this document" required></textarea>
                                <label id="docDesc-error" class="error" for="docDesc"></label>
                            </div>
                            <div class="qms-field qms-field-date">
                                <label for="datepicker">Release date</label>
                                <div class="qms-date-wrap">
                                    <input readonly="readonly" name="rlsDate" type="text" id="datepicker" class="form-control rlsDate" placeholder="Select date" required autocomplete="off">
                                    <button type="button" class="qms-date-trigger" id="qmsDateTrigger" aria-label="Open calendar">
                                        <i class="fa fa-calendar" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <label id="rlsDate-error" class="error" for="rlsDate"></label>
                            </div>
                        </div>
                    </div>
                    <div class="qms-form-actions">
                        <button type="button" class="qms-btn qms-btn-ghost" data-dismiss="modal">Cancel</button>
                        <button type="button" id="resetForm" class="qms-btn qms-btn-muted">Reset</button>
                        <button type="submit" class="qms-btn qms-btn-primary"><i class="fa fa-upload" aria-hidden="true"></i> Add File</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="qms-form-modal" id="myModalEdit" tabindex="-1" role="dialog" aria-labelledby="editDocTitle" aria-hidden="true">
        <div class="modal-dialog qms-form-dialog" role="document">
            <div class="modal-content qms-form-card">
                <div class="modal-header qms-form-header">
                    <div class="qms-form-heading">
                        <span class="qms-form-kicker">Update document</span>
                        <span class="qms-form-title" id="editDocTitle"><%= menu; %> / <%= submenu; %></span>
                    </div>
                    <button type="button" class="qms-form-close" data-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <form autocomplete="off" action="/editDocument/<%= menu; %>/<%= submenu; %>" enctype="multipart/form-data" method="post" class="updateForm valdUpdtFile qms-upload-form qms-form-shell" id="updateForm">
                    <input type="hidden" name="doc_id" class="doc_id" value="">
                    <input type="hidden" name="doc_file" class="old_doc_file" value="">
                    <div class="modal-body qms-form-body">
                        <div class="qms-form-grid">
                            <div class="qms-field">
                                <label for="editDocName">Document name</label>
                                <input type="text" class="form-control doc_name" placeholder="Enter document name" name="docname" id="editDocName" required>
                                <label id="editDocName-error" class="error" for="editDocName"></label>
                            </div>
                            <div class="qms-field qms-field-file">
                                <label for="selectedFile">Document file</label>
                                <label class="qms-file-drop" for="selectedFile">
                                    <input type="file" class="qms-file-input selectedFile" id="selectedFile" name="new_doc">
                                    <input type="hidden" id="fakeInput" name="fakeInput" class="fakeInput" value="">
                                    <span class="qms-file-icon"><i class="fa fa-cloud-upload" aria-hidden="true"></i></span>
                                    <span class="qms-file-copy">
                                        <strong id="qmsEditFileLabel">Choose a file</strong>
                                        <small>PDF, Word, Excel or PowerPoint</small>
                                    </span>
                                </label>
                                <label id="selectedFile-error" class="error" for="selectedFile"></label>
                                <label id="fakeInput-error" class="error" for="fakeInput"></label>
                            </div>
                            <div class="qms-field">
                                <label for="relsVerDoc">QMS released version</label>
                                <input id="relsVerDoc" name="relsVer" type="text" class="form-control relsVer" placeholder="e.g. 3.0" required readonly>
                                <label id="relsVerDoc-error" class="error" for="relsVerDoc"></label>
                            </div>
                            <div class="qms-field">
                                <label for="docVerUpd">Document version</label>
                                <input id="docVerUpd" name="docVer" type="text" class="form-control docVer" placeholder="e.g. 1.2" required readonly>
                                <label id="docVerUpd-error" class="error" for="docVerUpd"></label>
                            </div>
                            <div class="qms-field qms-field-wide">
                                <span>Version bump</span>
                                <div class="qms-bump-row">
                                    <label><input type="radio" name="bumpType" value="minor" checked> Minor <small id="qmsMinorHint">(1.0 → 1.1)</small></label>
                                    <label><input type="radio" name="bumpType" value="major"> Major <small id="qmsMajorHint">(1.0 → 2.0)</small></label>
                                </div>
                            </div>
                            <div class="qms-field qms-field-wide">
                                <label for="changeComment">Change comment</label>
                                <textarea name="changeComment" class="form-control qms-ver-comment-input" id="changeComment" rows="3" maxlength="500" placeholder="What changed and why?" required></textarea>
                                <label id="changeComment-error" class="error" for="changeComment"></label>
                            </div>
                            <div class="qms-field qms-field-wide">
                                <label for="editDocDesc">Description</label>
                                <textarea name="docDesc" class="form-control docDesc" id="editDocDesc" rows="3" placeholder="Short description of this document" required></textarea>
                                <label id="docDesc-error" class="error" for="docDesc"></label>
                            </div>
                            <div class="qms-field qms-field-date">
                                <label for="editDatepicker">Release date</label>
                                <div class="qms-date-wrap">
                                    <input readonly="readonly" name="rlsDate" type="text" id="editDatepicker" class="form-control rlsDate" placeholder="Select date" required autocomplete="off">
                                    <button type="button" class="qms-date-trigger" id="qmsEditDateTrigger" aria-label="Open calendar">
                                        <i class="fa fa-calendar" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <label id="editDatepicker-error" class="error" for="editDatepicker"></label>
                            </div>
                        </div>
                    </div>
                    <div class="qms-form-actions">
                        <button type="button" class="qms-btn qms-btn-ghost" data-dismiss="modal">Cancel</button>
                        <button type="button" id="resetUserUpdate" class="qms-btn qms-btn-muted">Reset</button>
                        <button type="submit" class="qms-btn qms-btn-primary updfile"><i class="fa fa-pencil" aria-hidden="true"></i> Update File</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal" id="qmsViewModal" tabindex="-1">
        <div class="modal-dialog qms-view-dialog">
            <div class="modal-content qms-view-modal">
                <div class="modal-header qms-view-header">
                    <div class="qms-view-heading">
                        <span class="qms-view-kicker">Document preview</span>
                        <span class="qms-view-title">View file</span>
                    </div>
                    <div class="qms-view-header-actions">
                        <button type="button" class="qms-view-update" id="qmsViewUpdate" hidden>
                            <i class="fa fa-upload"></i> Update
                        </button>
                        <button type="button" class="qms-view-replace" id="qmsViewReplace" hidden>
                            <i class="fa fa-file"></i> Update content
                        </button>
                        <button type="button" class="qms-view-save" id="qmsViewSave" hidden>
                            <i class="fa fa-save"></i> Save
                        </button>
                        <input type="file" id="qmsViewReplaceInput" hidden accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx">
                        <a class="qms-view-download" href="#" title="Download"><i class="fa fa-download"></i></a>
                        <button type="button" class="close-btn-design qms-view-close" data-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times fa-2x" style="color:#D23B68"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-body qms-view-body">
                    <div class="qms-edit-hint" hidden>Edit the content of this original document. Save keeps the same Word, PDF, PowerPoint, or Excel file and format.</div>
                    <div class="qms-replace-note" hidden></div>
                    <div class="qms-view-loading">Loading preview…</div>
                    <iframe class="qms-view-frame" title="Document preview"></iframe>
                    <div class="qms-view-html"></div>
                    <div class="qms-view-table-wrap"></div>
                    <div class="qms-view-error"></div>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
<div id="folderAppConfig"
     data-menu="<%= menu || '' %>"
     data-submenu="<%= submenu || '' %>"
     data-username="<%= typeof username !== 'undefined' ? username : '' %>"
     data-userrole="<%= userrole %>"></div>
<div class="folder-overlay" id="folderOverlay"></div>
<aside class="folder-workspace" id="folderWorkspace" aria-hidden="true">
    <div class="folder-ws-header">
        <div>
            <h3>Controlled Folders</h3>
            <p><%= menu || 'Category' %> &gt; <%= submenu || '' %> · organization, permissions, sharing, lifecycle, and audit</p>
        </div>
        <button type="button" class="folder-ws-close" id="closeFolderWorkspace" title="Close">&times;</button>
    </div>
    <div class="folder-msg" id="folderWorkspaceMsg"></div>
    <div class="folder-ws-body">
        <div class="folder-tree-pane">
            <div class="folder-tree-tools">
                <input type="search" id="folderTreeSearch" placeholder="Search folders and documents">
                <div class="folder-tree-actions">
                    <button type="button" class="folder-mini-btn" id="folderCreateBtn">New folder</button>
                    <button type="button" class="folder-mini-btn ghost" id="folderRefreshBtn">Refresh</button>
                </div>
            </div>
            <div class="folder-tree-list" id="folderTreeList"></div>
        </div>
        <div class="folder-detail-pane">
            <div class="folder-tabs">
                <button type="button" class="folder-tab is-active" data-tab="overview">Overview</button>
                <button type="button" class="folder-tab" data-tab="documents">Documents</button>
                <button type="button" class="folder-tab" data-tab="access">Permissions</button>
                <button type="button" class="folder-tab" data-tab="sharing">Sharing</button>
                <button type="button" class="folder-tab" data-tab="lifecycle">Lifecycle</button>
                <button type="button" class="folder-tab" data-tab="audit">Audit</button>
                <button type="button" class="folder-tab" data-tab="create">Create</button>
            </div>
            <div class="folder-tab-panels">
                <div class="folder-placeholder" id="folderPlaceholder">
                    <i class="fas fa-folder-open"></i>
                    Select a folder to manage organization, access, sharing, document assignment, lifecycle, and audit history.
                </div>
                <div id="folderDetailContent" style="display:none;">
                    <div class="folder-tab-panel is-active" id="folderTab-overview">
                        <h4 id="folderTitle"></h4>
                        <p id="folderMeta"></p>
                        <div class="folder-form-grid">
                            <div>
                                <label for="folderName">Folder name</label>
                                <input type="text" id="folderName" maxlength="150">
                            </div>
                            <div>
                                <label for="folderParent">Parent folder</label>
                                <select id="folderParent"></select>
                            </div>
                            <div class="full">
                                <label for="folderDesc">Description</label>
                                <textarea id="folderDesc" rows="3"></textarea>
                            </div>
                            <div>
                                <label for="folderVisibility">Visibility</label>
                                <select id="folderVisibility">
                                    <option value="private">Private — owner only</option>
                                    <option value="restricted">Restricted — granted users</option>
                                    <option value="shared">Shared — explicit shares</option>
                                    <option value="public">Public — all logged-in users</option>
                                </select>
                            </div>
                            <div>
                                <label for="folderInherit">Inherit parent access</label>
                                <select id="folderInherit">
                                    <option value="1">Yes</option>
                                    <option value="0">No</option>
                                </select>
                            </div>
                            <div>
                                <label for="folderTags">Tags</label>
                                <input type="text" id="folderTags" placeholder="sop, records, hr">
                            </div>
                            <div>
                                <label for="folderReview">Review date</label>
                                <input type="date" id="folderReview">
                            </div>
                            <div>
                                <label for="folderRetain">Retain until</label>
                                <input type="date" id="folderRetain">
                            </div>
                        </div>
                        <div class="folder-actions">
                            <button type="button" class="folder-primary" id="folderSaveBtn">Save organization</button>
                            <button type="button" class="folder-danger" id="folderDeleteBtn">Delete folder</button>
                        </div>
                    </div>
                    <div class="folder-tab-panel" id="folderTab-documents">
                        <div class="folder-inline-row" id="folderDocAssign">
                            <div class="folder-field">
                                <label for="folderAddDocs">Assign category documents</label>
                                <select id="folderAddDocs" multiple size="4"></select>
                            </div>
                            <button type="button" class="folder-primary" id="folderAssignDocs">Add to folder</button>
                        </div>
                        <table class="folder-table">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Description</th>
                                    <th>Version</th>
                                    <th>Released</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="folderDocRows"></tbody>
                        </table>
                    </div>
                    <div class="folder-tab-panel" id="folderTab-access">
                        <div class="folder-actions" style="margin-bottom:12px;">
                            <button type="button" class="folder-primary" id="folderOpenAccessPanel">Who has access</button>
                        </div>
                        <div class="folder-inline-row" id="folderPermAssign">
                            <div class="folder-field">
                                <label for="folderPermUser">User</label>
                                <select id="folderPermUser"></select>
                            </div>
                            <div class="folder-field">
                                <label for="folderPermRole">Role</label>
                                <select id="folderPermRole">
                                    <option value="viewer">Viewer</option>
                                    <option value="auditor">Auditor</option>
                                    <option value="editor">Editor</option>
                                    <option value="owner">Owner</option>
                                </select>
                            </div>
                            <button type="button" class="folder-primary" id="folderGrantPerm">Grant</button>
                        </div>
                        <table class="folder-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Role</th>
                                    <th>Granted</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="folderPermRows"></tbody>
                        </table>
                    </div>
                    <div class="folder-tab-panel" id="folderTab-sharing">
                        <div class="folder-inline-row" id="folderShareAssign">
                            <div class="folder-field">
                                <label for="folderShareUser">Share with</label>
                                <select id="folderShareUser"></select>
                            </div>
                            <div class="folder-field">
                                <label for="folderShareRole">Access</label>
                                <select id="folderShareRole">
                                    <option value="viewer">Viewer</option>
                                    <option value="auditor">Auditor</option>
                                    <option value="editor">Editor</option>
                                </select>
                            </div>
                            <div class="folder-field">
                                <label for="folderShareExpiry">Expires</label>
                                <input type="datetime-local" id="folderShareExpiry">
                            </div>
                            <button type="button" class="folder-primary" id="folderCreateShare">Share</button>
                        </div>
                        <table class="folder-table">
                            <thead>
                                <tr>
                                    <th>Shared with</th>
                                    <th>Access</th>
                                    <th>Expires</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="folderShareRows"></tbody>
                        </table>
                    </div>
                    <div class="folder-tab-panel" id="folderTab-lifecycle">
                        <p id="folderLifecycleNow"></p>
                        <p class="folder-muted" id="folderReviewHint"></p>
                        <p class="folder-muted" id="folderRetainHint"></p>
                        <div class="folder-lifecycle-btns folder-actions" id="folderLifecycleBtns"></div>
                    </div>
                    <div class="folder-tab-panel" id="folderTab-audit">
                        <table class="folder-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Actor</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody id="folderAuditRows"></tbody>
                        </table>
                    </div>
                </div>
                <div class="folder-tab-panel" id="folderTab-create">
                    <form id="folderCreateForm">
                        <div class="folder-form-grid">
                            <div>
                                <label for="createFolderName">Folder name</label>
                                <input type="text" id="createFolderName" required maxlength="150">
                            </div>
                            <div>
                                <label for="folderCreateParent">Parent folder</label>
                                <select id="folderCreateParent"></select>
                            </div>
                            <div class="full">
                                <label for="createFolderDesc">Description</label>
                                <textarea id="createFolderDesc" rows="3"></textarea>
                            </div>
                            <div>
                                <label for="createFolderVisibility">Visibility</label>
                                <select id="createFolderVisibility">
                                    <option value="restricted">Restricted</option>
                                    <option value="private">Private</option>
                                    <option value="shared">Shared</option>
                                    <option value="public">Public</option>
                                </select>
                            </div>
                            <div>
                                <label for="createFolderInherit">Inherit parent access</label>
                                <select id="createFolderInherit">
                                    <option value="1">Yes</option>
                                    <option value="0">No</option>
                                </select>
                            </div>
                            <div>
                                <label for="createFolderTags">Tags</label>
                                <input type="text" id="createFolderTags">
                            </div>
                            <div>
                                <label for="createFolderReview">Review date</label>
                                <input type="date" id="createFolderReview">
                            </div>
                            <div>
                                <label for="createFolderRetain">Retain until</label>
                                <input type="date" id="createFolderRetain">
                            </div>
                        </div>
                        <div class="folder-actions">
                            <button type="submit" class="folder-primary">Create controlled folder</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</aside>
