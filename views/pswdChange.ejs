<%- include('includes/header'); -%>
<%- include('includes/app-shell-start'); -%> 
<section class="section-profile">   
    <div class="bread-heading" > 
      <nav aria-label="breadcrumb" style="margin-top:20px;">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active" id="li-Heade" aria-current="page" style="color:#f2f2f2;font-size: 20px; font-weight: 500;">User Profile</li>
        </ol>
      </nav>                  
      <nav style="margin-top:-16px;" aria-label="breadcrumb">
        <ol class="breadcrumb" >
          <li class="" ><a href="/home" class="Bradscram-p1" style="color:#f2f2f2;">Home > &nbsp;</a></li>
          <li class="" aria-current="page" style="color:#f2f2f2;"><span class="Bradscram-p1_Span" style="color:#f2f2f2;">Change Password</span></li>
        </ol>
      </nav>
    </div>   
    <% if(succupd.length > 0) { %>
      <div class="alert alert-success pswdchmsg" role="alert">
          <%= succupd %>
      </div>
    <% } %>  
    <div class="user_det pswd-card">
      <form action="/changePassword" method="post" id="pswdchng">
        <div class="row mt-2" >
          <div class="col-12" style="color:white;">
            <label for="">Email Id</label>             
            <input type="text" name="email_id" class="form-control frminput inputfrmt" placeholder="Email ID" value="<%= username %>" disabled required>              
          </div>                                    
        </div>
        <div class="row mt-2" >
          <div class="col-12" style="color:white;">
            <label for="" >Password</label>
            <input type="password" name="paswd" id="paswd" class="form-control inputfrmt" placeholder="Password" value="" required>
          </div>                  
        </div>
        <div class="row mt-2">
          <div class="col-12" style="color:white;">
            <label for="">Confirm Password</label>
            <input type="password" name="cpaswd" id="cpaswd" class="form-control inputfrmt" placeholder="Confirm Password" value="" required>
          </div>                     
        </div>
        <div class="d-flex justify-content-center mt-3 login_container form-actions">
          <button type="submit" name="button" class="btn chpwsdBtn" onclick="matchPassword()" style="background-color: rgb(46, 46, 146) !important;">Update Password</button>
          <button type="button" name="button" class="btn rsBtn" style="background-color: rgb(70, 70, 71) !important;">Reset</button>
        </div>
      </form>
    </div>
</section>
<%- include('includes/app-shell-end'); -%>
<%- include('includes/footer'); -%> 
